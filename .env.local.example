NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://votre-projet-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Home Assistant — utilisé uniquement côté serveur par /api/home-assistant/irrigation
# ou par le bridge local gratuit scripts/home-assistant-irrigation-bridge.mjs.
# Ne jamais préfixer avec NEXT_PUBLIC_ : le token ne doit pas partir dans le navigateur.
HOME_ASSISTANT_URL=http://100.102.159.31:8123
HOME_ASSISTANT_TOKEN=eyJ...long-lived-token...

# Bridge local gratuit Ferme ↔ Firebase ↔ Home Assistant.
# Utiliser un compte Firebase autorisé sur la Realtime Database.
FIREBASE_EMAIL=bridge@example.com
FIREBASE_PASSWORD=mot-de-passe-du-compte-bridge
HA_BRIDGE_POLL_MS=15000
